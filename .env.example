# Copy to .env to override.
# Port PostgreSQL publishes on 127.0.0.1. After changing it, run scripts/install-native.sh again.
DB_PORT=5433

# Address that port listens on. Only change this if your shell is in a container using the
# outer host's Docker. Use the host's internal address, not 0.0.0.0.
DB_BIND=127.0.0.1
