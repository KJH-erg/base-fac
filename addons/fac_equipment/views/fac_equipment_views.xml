<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fac_equipment_view_list" model="ir.ui.view">
        <field name="name">fac.equipment.list</field>
        <field name="model">fac.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="location"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'in_use'"
                       decoration-warning="state == 'maintenance'"
                       decoration-danger="state == 'broken'"/>
            </list>
        </field>
    </record>

    <record id="fac_equipment_view_form" model="ir.ui.view">
        <field name="name">fac.equipment.form</field>
        <field name="model">fac.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <header>
                    <button name="action_set_in_use" string="Start Use" type="object" class="oe_highlight"
                            invisible="state not in ('available',)"/>
                    <button name="action_set_available" string="Set Available" type="object"
                            invisible="state not in ('in_use', 'maintenance')"/>
                    <button name="action_set_maintenance" string="Send to Maintenance" type="object"
                            invisible="state not in ('available', 'in_use', 'broken')"/>
                    <button name="action_set_broken" string="Report Broken" type="object"
                            invisible="state == 'broken'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_status_log" type="object" class="oe_stat_button" icon="history">
                            <field name="status_log_count" widget="statinfo" string="Status Changes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. CNC Lathe #1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Status History" name="status_history">
                            <field name="status_log_ids">
                                <list>
                                    <field name="changed_on"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="changed_by_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fac_equipment_view_search" model="ir.ui.view">
        <field name="name">fac.equipment.search</field>
        <field name="model">fac.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="category"/>
                <field name="location"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="In Use" name="in_use" domain="[('state', '=', 'in_use')]"/>
                <filter string="Under Maintenance" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter string="Broken" name="broken" domain="[('state', '=', 'broken')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fac_equipment_action" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">fac.equipment</field>
        <field name="path">fac-equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fac_equipment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first piece of equipment</p>
        </field>
    </record>

</odoo>
