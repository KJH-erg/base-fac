<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fac_inspection_spec_view_list" model="ir.ui.view">
        <field name="name">fac.inspection.spec.list</field>
        <field name="model">fac.inspection.spec</field>
        <field name="arch" type="xml">
            <list string="Inspection Standards">
                <field name="code"/>
                <field name="name"/>
                <field name="characteristic"/>
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <record id="fac_inspection_spec_view_form" model="ir.ui.view">
        <field name="name">fac.inspection.spec.form</field>
        <field name="model">fac.inspection.spec</field>
        <field name="arch" type="xml">
            <form string="Inspection Standard">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Shaft OD Check"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="characteristic"/>
                            <field name="unit"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="lower_limit"/>
                            <field name="upper_limit"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Measurement method, tools, sampling..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fac_inspection_spec_view_search" model="ir.ui.view">
        <field name="name">fac.inspection.spec.search</field>
        <field name="model">fac.inspection.spec</field>
        <field name="arch" type="xml">
            <search string="Inspection Standards">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="characteristic"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="fac_inspection_spec_action" model="ir.actions.act_window">
        <field name="name">Inspection Standards</field>
        <field name="res_model">fac.inspection.spec</field>
        <field name="path">fac-inspection-standards</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fac_inspection_spec_view_search"/>
    </record>

</odoo>
