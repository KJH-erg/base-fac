<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fac_workorder_view_list" model="ir.ui.view">
        <field name="name">fac.workorder.list</field>
        <field name="model">fac.workorder</field>
        <field name="arch" type="xml">
            <list string="Work Orders">
                <field name="name"/>
                <field name="product_name"/>
                <field name="quantity"/>
                <field name="equipment_ref"/>
                <field name="assignee_id" widget="many2one_avatar_user"/>
                <field name="planned_start"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'planned'"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state == 'on_hold'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="fac_workorder_view_form" model="ir.ui.view">
        <field name="name">fac.workorder.form</field>
        <field name="model">fac.workorder</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight"
                            invisible="state != 'planned'"/>
                    <button name="action_hold" string="Hold" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_resume" string="Resume" type="object" class="oe_highlight"
                            invisible="state != 'on_hold'"/>
                    <button name="action_done" string="Finish" type="object" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_name" readonly="state == 'done'"/>
                            <field name="quantity" readonly="state == 'done'"/>
                            <field name="equipment_ref" readonly="state == 'done'"
                                   placeholder="e.g. EQ-CNC-01"/>
                            <field name="assignee_id" widget="many2one_avatar_user" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="planned_start" readonly="state != 'planned'"/>
                            <field name="date_started"/>
                            <field name="date_done"/>
                            <field name="hold_reason" invisible="state != 'on_hold'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions" name="instructions">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fac_workorder_view_search" model="ir.ui.view">
        <field name="name">fac.workorder.search</field>
        <field name="model">fac.workorder</field>
        <field name="arch" type="xml">
            <search string="Work Orders">
                <field name="name"/>
                <field name="product_name"/>
                <field name="equipment_ref"/>
                <field name="assignee_id"/>
                <filter string="My Work Orders" name="my" domain="[('assignee_id', '=', uid)]"/>
                <separator/>
                <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="On Hold" name="on_hold" domain="[('state', '=', 'on_hold')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_ref'}"/>
                    <filter string="Assignee" name="group_assignee" context="{'group_by': 'assignee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fac_workorder_action" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">fac.workorder</field>
        <field name="path">fac-workorders</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fac_workorder_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first work order</p>
        </field>
    </record>

</odoo>
