<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mes_energy" model="res.groups.privilege">
        <field name="name">에너지</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_energy_user" model="res.groups">
        <field name="name">기록 담당자</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mes_energy"/>
        <field name="comment">설비 조회, 일일 사용량 입력·수정·삭제(마감 전), 계측 파일 가져오기, 월별 보기를 할 수 있습니다.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_energy_manager" model="res.groups">
        <field name="name">관리자</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mes_energy"/>
        <field name="comment">기록 담당자의 모든 권한에 더해 설비 등록·수정·삭제와 월 마감·마감 취소를 할 수 있습니다.</field>
        <field name="implied_ids" eval="[(4, ref('group_energy_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
