<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_energy_equipment_search" model="ir.ui.view">
        <field name="name">mes.energy.equipment.search</field>
        <field name="model">mes.energy.equipment</field>
        <field name="arch" type="xml">
            <search string="설비 검색">
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <separator/>
                <filter string="사용 중지" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="위치" name="group_location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_mes_energy_equipment_list" model="ir.ui.view">
        <field name="name">mes.energy.equipment.list</field>
        <field name="model">mes.energy.equipment</field>
        <field name="arch" type="xml">
            <list string="설비" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="power_limit"/>
                <field name="water_limit"/>
                <field name="active" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_mes_energy_equipment_form" model="ir.ui.view">
        <field name="name">mes.energy.equipment.form</field>
        <field name="model">mes.energy.equipment</field>
        <field name="arch" type="xml">
            <form string="설비">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usages" type="object" class="oe_stat_button" icon="calendar_today">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="usage_count"/></span>
                                <span class="o_stat_text">일일 사용량</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="사용 중지" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="기본 정보">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="active"/>
                        </group>
                        <group string="일일 기준">
                            <field name="power_limit"/>
                            <field name="water_limit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mes_energy_equipment" model="ir.actions.act_window">
        <field name="name">설비</field>
        <field name="res_model">mes.energy.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mes_energy_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">설비를 등록하세요.</p>
            <p>설비마다 일일 전력·용수 기준을 정하면 일일 사용량의 초과 여부가 판정됩니다.</p>
        </field>
    </record>
</odoo>
