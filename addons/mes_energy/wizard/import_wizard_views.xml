<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_energy_import_wizard_form" model="ir.ui.view">
        <field name="name">mes.energy.import.wizard.form</field>
        <field name="model">mes.energy.import.wizard</field>
        <field name="arch" type="xml">
            <form string="계측 파일 가져오기">
                <field name="state" invisible="1"/>
                <div class="text-muted mb-2">
                    UTF-8 CSV 파일, 첫 줄 머리글: <code>equipment_code,date,power_kwh,water_m3</code>
                    (날짜는 YYYY-MM-DD, 사용량은 빈 칸 없이 숫자). 같은 설비·날짜의 기록이 있으면 갱신합니다.
                </div>
                <group>
                    <field name="file" filename="filename" options="{'accepted_file_extensions': '.csv'}"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div invisible="state != 'done'">
                    <h4>가져오기 결과</h4>
                    <group>
                        <group>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="rejected_count" decoration-danger="rejected_count &gt; 0"/>
                        </group>
                    </group>
                    <div invisible="rejected_count == 0">
                        <p class="text-muted">줄 번호는 머리글을 1번으로 셉니다.</p>
                        <field name="line_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="line_no"/>
                                <field name="reason"/>
                                <field name="content"/>
                            </list>
                        </field>
                    </div>
                </div>
                <footer>
                    <button string="가져오기" name="action_import" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="닫기" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mes_energy_import_wizard" model="ir.actions.act_window">
        <field name="name">계측 파일 가져오기</field>
        <field name="res_model">mes.energy.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mes_energy_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
