<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_mes_maintenance_preventive" model="ir.cron">
            <field name="name">정비: 예방 정비 요청 자동 생성</field>
            <field name="model_id" ref="model_mes_maintenance_equipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_preventive_requests()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d 21:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
