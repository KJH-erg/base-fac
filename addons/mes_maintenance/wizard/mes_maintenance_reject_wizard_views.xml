<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_maintenance_reject_wizard_form" model="ir.ui.view">
        <field name="name">mes.maintenance.reject.wizard.form</field>
        <field name="model">mes.maintenance.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="반려 사유">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="반려하는 이유를 적어 주세요."/>
                </group>
                <footer>
                    <button name="action_confirm" string="반려" type="object" class="btn-primary"/>
                    <button string="취소" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
