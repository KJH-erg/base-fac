<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_mes_material_shortage" model="ir.cron">
            <field name="name">자재 관리: 재고 부족 경고 생성</field>
            <field name="model_id" ref="model_mes_material_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_shortage()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
