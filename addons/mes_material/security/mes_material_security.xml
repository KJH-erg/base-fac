<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mes_material" model="res.groups.privilege">
        <field name="name">자재 관리</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_mes_material_user" model="res.groups">
        <field name="name">자재 담당자</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mes_material"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mes_material_manager" model="res.groups">
        <field name="name">관리자</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mes_material"/>
        <field name="implied_ids" eval="[(4, ref('group_mes_material_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
