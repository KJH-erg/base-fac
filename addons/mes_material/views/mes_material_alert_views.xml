<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_material_alert_list" model="ir.ui.view">
        <field name="name">mes.material.alert.list</field>
        <field name="model">mes.material.alert</field>
        <field name="arch" type="xml">
            <list string="재고 부족 경고" create="0" delete="0" decoration-muted="is_done">
                <field name="check_datetime"/>
                <field name="material_id"/>
                <field name="qty_on_hand"/>
                <field name="safety_qty"/>
                <field name="uom"/>
                <field name="is_done"/>
                <field name="done_user_id" optional="hide"/>
                <field name="done_datetime" optional="hide"/>
                <button name="action_mark_done" string="처리 완료" type="object" icon="check"
                        invisible="is_done"/>
            </list>
        </field>
    </record>

    <record id="view_mes_material_alert_form" model="ir.ui.view">
        <field name="name">mes.material.alert.form</field>
        <field name="model">mes.material.alert</field>
        <field name="arch" type="xml">
            <form string="재고 부족 경고" create="0" delete="0">
                <header>
                    <button name="action_mark_done" string="처리 완료" type="object" class="btn-primary"
                            invisible="is_done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="처리 완료" bg_color="text-bg-success" invisible="not is_done"/>
                    <group>
                        <group>
                            <field name="material_id"/>
                            <field name="check_datetime"/>
                            <field name="qty_on_hand"/>
                            <field name="safety_qty"/>
                            <field name="uom"/>
                        </group>
                        <group>
                            <field name="is_done"/>
                            <field name="done_user_id" invisible="not is_done"/>
                            <field name="done_datetime" invisible="not is_done"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mes_material_alert_search" model="ir.ui.view">
        <field name="name">mes.material.alert.search</field>
        <field name="model">mes.material.alert</field>
        <field name="arch" type="xml">
            <search string="재고 부족 경고 검색">
                <field name="material_id"/>
                <filter string="미처리" name="filter_pending" domain="[('is_done', '=', False)]"/>
                <filter string="처리 완료" name="filter_done" domain="[('is_done', '=', True)]"/>
                <separator/>
                <filter string="확인 일시" name="filter_check_datetime" date="check_datetime"/>
                <group>
                    <filter string="자재" name="groupby_material" context="{'group_by': 'material_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mes_material_alert" model="ir.actions.act_window">
        <field name="name">재고 부족 경고</field>
        <field name="res_model">mes.material.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mes_material_alert_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">재고 부족 경고가 없습니다.</p>
            <p>매일 한 번, 사용 중이고 재고 부족인 자재마다 경고가 생깁니다.</p>
        </field>
    </record>
</odoo>
