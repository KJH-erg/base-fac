<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_mes_material" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.mes_material</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_mes_materials" type="object" class="oe_stat_button"
                        icon="inventory_2" groups="mes_material.group_mes_material_user">
                    <field name="mes_material_count" widget="statinfo" string="공급 자재"/>
                </button>
            </div>
        </field>
    </record>

    <record id="action_mes_material_partner" model="ir.actions.act_window">
        <field name="name">공급처</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">공급처(거래처)가 없습니다.</p>
        </field>
    </record>
</odoo>
