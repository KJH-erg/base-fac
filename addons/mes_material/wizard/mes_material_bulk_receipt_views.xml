<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mes_material_bulk_receipt_form" model="ir.ui.view">
        <field name="name">mes.material.bulk.receipt.form</field>
        <field name="model">mes.material.bulk.receipt</field>
        <field name="arch" type="xml">
            <form string="일괄 입고">
                <group>
                    <group>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                    </group>
                </group>
                <p class="text-muted">입고할 자재에 수량을 넣으세요. 수량이 0인 줄은 건너뜁니다.</p>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="material_id" options="{'no_create': True}"/>
                        <field name="qty_on_hand"/>
                        <field name="qty"/>
                        <field name="uom"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="입고 확정" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="닫기" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mes_material_bulk_receipt" model="ir.actions.act_window">
        <field name="name">일괄 입고</field>
        <field name="res_model">mes.material.bulk.receipt</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mes_material_bulk_receipt_form"/>
        <field name="target">new</field>
    </record>
</odoo>
