<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_mes_qc_inspection" model="ir.sequence">
        <field name="name">검사 번호</field>
        <field name="code">mes.qc.inspection</field>
        <field name="prefix">QC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_mes_qc_ncr" model="ir.sequence">
        <field name="name">부적합 보고서 번호</field>
        <field name="code">mes.qc.ncr</field>
        <field name="prefix">NCR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
