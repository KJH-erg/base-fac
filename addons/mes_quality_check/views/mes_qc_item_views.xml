<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mes_qc_item_view_list" model="ir.ui.view">
        <field name="name">mes.qc.item.list</field>
        <field name="model">mes.qc.item</field>
        <field name="arch" type="xml">
            <list string="검사 항목" decoration-muted="not active">
                <field name="name"/>
                <field name="uom"/>
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="active" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="mes_qc_item_view_form" model="ir.ui.view">
        <field name="name">mes.qc.item.form</field>
        <field name="model">mes.qc.item</field>
        <field name="arch" type="xml">
            <form string="검사 항목">
                <sheet>
                    <widget name="web_ribbon" title="사용 중지" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="예: 길이"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="uom" placeholder="예: mm"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="lower_limit"/>
                            <field name="upper_limit"/>
                        </group>
                    </group>
                    <group>
                        <field name="line_count" string="사용된 측정 줄 수"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mes_qc_item_view_search" model="ir.ui.view">
        <field name="name">mes.qc.item.search</field>
        <field name="model">mes.qc.item</field>
        <field name="arch" type="xml">
            <search string="검사 항목 검색">
                <field name="name"/>
                <field name="uom"/>
                <separator/>
                <filter name="inactive" string="사용 중지" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="mes_qc_item_action" model="ir.actions.act_window">
        <field name="name">검사 항목</field>
        <field name="res_model">mes.qc.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mes_qc_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">검사 항목을 등록하십시오.</p>
            <p>항목 이름, 단위, 하한값·상한값을 정하면 측정값을 자동으로 판정합니다.</p>
        </field>
    </record>
</odoo>
