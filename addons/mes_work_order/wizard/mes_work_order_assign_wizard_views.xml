<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mes_work_order_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">mes.work.order.assign.wizard.view.form</field>
        <field name="model">mes.work.order.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="일괄 담당자 지정">
                <group>
                    <field name="user_id" widget="many2one_avatar" options="{'no_create': True}"/>
                </group>
                <field name="work_order_ids" readonly="1" force_save="1">
                    <list>
                        <field name="name"/>
                        <field name="title"/>
                        <field name="user_id" string="현재 담당자"/>
                        <field name="date_end"/>
                        <field name="is_delayed"/>
                        <field name="state"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="지정" class="btn-primary"/>
                    <button string="닫기" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mes_work_order_assign_wizard_action" model="ir.actions.act_window">
        <field name="name">일괄 담당자 지정</field>
        <field name="res_model">mes.work.order.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_mes_work_order"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('mes_work_order.group_mes_manager'))]"/>
    </record>
</odoo>
